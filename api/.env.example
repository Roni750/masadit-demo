# Supabase Postgres connection string (Project Settings → Database → Connection string → Session pooler).
# Never commit the real value; request it from the project owner.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Extra comma-separated CORS origins (e.g. the Netlify site URL)
CORS_ORIGINS=
